# ─────────────────────────────────────────────────────────────────────────────
# AethoFlix Clone — environment configuration
# Copy this file to .env.local and fill in the values
# ─────────────────────────────────────────────────────────────────────────────

# TMDb v3 API key — get one free at https://www.themoviedb.org/settings/api
# (Request a free developer key — instant approval, no review process)
NEXT_PUBLIC_TMDB_API_KEY=27627ea97ee58d929e156ea961c6e255

# Watch-gate deployment secret (used to generate AETHO-XXXX-XXXX codes)
# Generate a random 12-character alphanumeric string, e.g.:
#   openssl rand -hex 6
#   or: node -e "console.log(require('crypto').randomBytes(6).toString('hex'))"
# DO NOT commit this — anyone with this secret can forge watch-gate codes.
WATCH_GATE_SECRET=changeme_to_random_12_chars

# Ad-partner URLs (optional — set both to disable the watch-gate, or fill in
# to require users to visit an ad partner before showing the iframe)
# Leave empty to disable the watch-gate entirely (Path A / legit mode)
AD_PARTNER_URL_1=
AD_PARTNER_URL_2=

# Optional: hide the mirror picker behind a code gate even without ads
# (useful for testing — set to "true" to always require a code, "false" to skip)
WATCH_GATE_ENABLED=false

# Site name shown in the navbar / footer (customise for your clone)
NEXT_PUBLIC_SITE_NAME=MyFlix

# Optional: deploy-time override for the live TV endpoint
# (if you want to build your own channel list instead of using LiveTVGT)
NEXT_PUBLIC_LIVETV_ENDPOINT=https://livetgtv.lovable.app/api/public/v2/channels
